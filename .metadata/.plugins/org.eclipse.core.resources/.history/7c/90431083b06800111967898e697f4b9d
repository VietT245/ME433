/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();
  MX_I2C2_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();

  /* USER CODE BEGIN 2 */
  init_ina219();

  /* Both channels high = motor off at startup */
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_PERIOD);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, PWM_PERIOD);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);

  /* Start 1 kHz interrupt */
  HAL_TIM_Base_Start_IT(&htim2);
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_GREEN);
  BSP_LED_Init(LED_BLUE);

  /* Initialize USER push-button */
  BSP_PB_Init(BUTTON_USER, BUTTON_MODE_EXTI);

  /* Initialize COM1 port (115200, 8 bits, no parity) */
  BspCOMInit.BaudRate   = 115200;
  BspCOMInit.WordLength = COM_WORDLENGTH_8B;
  BspCOMInit.StopBits   = COM_STOPBITS_1;
  BspCOMInit.Parity     = COM_PARITY_NONE;
  BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
  if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE)
  {
    Error_Handler();
  }

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  printf("Ready. Send 'a' to run current control.\r\n");

  while (1)
  {
    uint8_t ch = 0;
    if (HAL_UART_Receive(&huart2, &ch, 1, 0) == HAL_OK)
    {
      if (ch == 'a')
      {
        printf("Starting current control run...\r\n");
        log_count = 0;
        state = 1;

        /* Wait for ISR to finish the 400-cycle run */
        while (state != 0) {}

        /* Print CSV log (floats sent as x10 integers - printf float unreliable) */
        printf("IDX,DESIRED_mA_x10,ACTUAL_mA_x10,ADC\r\n");
        for (uint32_t i = 0; i < log_count; i++)
        {
          int d = (int)(log_desired[i] * 10.0f);
          int a = (int)(log_actual[i]  * 10.0f);
          printf("%lu,%d,%d,%u\r\n",
                 (unsigned long)i, d, a,
                 (unsigned int)log_adc[i]);
        }
        printf("Done.\r\n");
      }
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

