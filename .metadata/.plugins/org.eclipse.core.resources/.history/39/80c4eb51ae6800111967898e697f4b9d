/* ── INA219 registers ────────────────────────────────────────────────────── */
#define INA219_ADDR            0x40
#define INA219_REG_CONFIG      0x00
#define INA219_REG_SHUNT       0x01
#define INA219_REG_BUS         0x02
#define INA219_REG_POWER       0x03
#define INA219_REG_CURRENT     0x04
#define INA219_REG_CALIBRATION 0x05

/* ── ADC safety limits ───────────────────────────────────────────────────── */
#define ADC_MIN   250
#define ADC_MAX   (4095 - 250)

/* ── PWM ─────────────────────────────────────────────────────────────────── */
#define PWM_PERIOD  2400        /* Counter Period set in CubeMX              */
#define PWM_OFF     PWM_PERIOD  /* both channels high = motor off (coast)    */
#define PWM_HALF    (PWM_PERIOD / 2)

/* ── PI controller ───────────────────────────────────────────────────────── */
#define KP               0.5f
#define KI               0.01f
#define DESIRED_CURRENT  300.0f   /* mA absolute value                       */
#define LOG_SIZE         400      /* samples per run (= 400 ms at 1 kHz)     */

/* ── State machine (shared between main and ISR) ─────────────────────────── */
volatile uint8_t state = 0;   /* 0 = idle, 1 = run control loop             */

/* ── Data log (filled in ISR, printed in main) ───────────────────────────── */
static float    log_desired[LOG_SIZE];
static float    log_actual [LOG_SIZE];
static uint16_t log_adc    [LOG_SIZE];
static uint32_t log_count  = 0;

