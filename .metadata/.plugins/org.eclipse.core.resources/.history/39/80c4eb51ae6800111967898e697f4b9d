/*
 * HAL_TIM_PeriodElapsedCallback
 * Called by the HAL every time TIM2 overflows (1 kHz).
 * Runs the safety check every tick, and the PI controller when state == 1.
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim != &htim2) return;

    /* ── Safety endstop: kill motor if potentiometer out of range ── */
    uint32_t adc = read_adc();
    if (adc < ADC_MIN || adc > ADC_MAX)
    {
        motor_off();
        if (state == 1) state = 0;   /* abort any running control loop */
        return;
    }

    /* ── PI current control loop ── */
    if (state == 1)
    {
        static uint32_t counter  = 0;
        static float    integral = 0.0f;

        /* Desired current: forward for first 200 cycles, reverse for next 200 */
        float desired = (counter < 200) ? DESIRED_CURRENT : -DESIRED_CURRENT;

        float actual  = read_ina219();
        float error   = desired - actual;
        integral     += error;

        /* Anti-windup clamp */
        if (integral >  5000.0f) integral =  5000.0f;
        if (integral < -5000.0f) integral = -5000.0f;

        float output = KP * error + KI * integral;

        /* Map output → PWM duty.  Positive = forward, negative = reverse. */
        int duty = (int)output;
        if (duty >  PWM_PERIOD) duty =  PWM_PERIOD;
        if (duty < -PWM_PERIOD) duty = -PWM_PERIOD;

        if (duty >= 0)
            motor_drive(PWM_PERIOD,        PWM_PERIOD - duty);
        else
            motor_drive(PWM_PERIOD + duty, PWM_PERIOD);

        /* Log */
        if (log_count < LOG_SIZE)
        {
            log_desired[log_count] = desired;
            log_actual [log_count] = actual;
            log_adc    [log_count] = (uint16_t)adc;
            log_count++;
        }

        counter++;

        /* End of run */
        if (counter >= LOG_SIZE)
        {
            motor_off();
            counter  = 0;
            integral = 0.0f;
            state    = 0;
        }
    }
}

