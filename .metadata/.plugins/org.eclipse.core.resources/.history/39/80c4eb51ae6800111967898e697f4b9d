    return ch;
}

/* ── ADC ─────────────────────────────────────────────────────────────────── */
uint32_t read_adc(void)
{
    uint32_t raw = 0;
    HAL_ADC_Start(&hadc1);
    if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
        raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    return raw;
}

/* ── INA219 ──────────────────────────────────────────────────────────────── */
void writeINA219(int reg, int value)
{
    uint8_t buf[3];
    buf[0] = (uint8_t)reg;
    buf[1] = (value >> 8) & 0xFF;
    buf[2] =  value       & 0xFF;
    HAL_I2C_Master_Transmit(&hi2c2, INA219_ADDR << 1, buf, 3, 10);
}

signed short readINA219(unsigned char reg)
{
    HAL_I2C_Master_Transmit(&hi2c2, INA219_ADDR << 1, &reg, 1, 10);
    uint8_t buffer[2] = {0, 0};
    HAL_I2C_Master_Receive(&hi2c2, INA219_ADDR << 1, buffer, 2, 10);
    return (signed short)((buffer[0] << 8) | buffer[1]);
}

void init_ina219(void)
{
    /* 10-bit resolution, ±160 mV shunt range, 148 µs conversion time */
    unsigned short calValue = 1024;
    unsigned short config   = 0x018F;   /* 0b0000000110001111 */
    writeINA219(INA219_REG_CALIBRATION, calValue);
    writeINA219(INA219_REG_CONFIG,      config);
}

float read_ina219(void)
{
    signed short raw = readINA219(INA219_REG_CURRENT);
    return raw / 3.0f;   /* raw units → mA */
}

/* ── Motor helpers ───────────────────────────────────────────────────────── */
void motor_off(void)
{
    /* Both channels high = coast on DRV8833; never drive both low */
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_OFF);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, PWM_OFF);
}

/*
 * motor_drive()
 *   Forward:  pwm_ch1 = PWM_PERIOD (100%), pwm_ch2 = reduced duty
 *   Reverse:  pwm_ch1 = reduced duty,      pwm_ch2 = PWM_PERIOD (100%)
 *   Rule:     NEVER set both channels to 0 simultaneously.
 */
void motor_drive(int pwm_ch1, int pwm_ch2)
{
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)pwm_ch1);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, (uint32_t)pwm_ch2);
}

