/* ── main ────────────────────────────────────────────────────────────────── */
int main(void)
{
    /* USER CODE BEGIN 1 */
    /* USER CODE END 1 */

    HAL_Init();
    SystemClock_Config();

    /* Peripheral init (generated by CubeMX — do not edit) */
    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_ADC1_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_I2C2_Init();

    /* USER CODE BEGIN 2 */

    init_ina219();

    /* Both PWM channels high = motor off at startup */
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_OFF);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, PWM_OFF);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);

    /* Start 1 kHz control / safety interrupt */
    HAL_TIM_Base_Start_IT(&htim2);

    printf("Ready.\r\n");
    printf("  'a' = run current control (400 ms)\r\n");
    printf("  't' = motor test (50%% each direction, 0.5 s)\r\n");

    /* USER CODE END 2 */

    /* USER CODE BEGIN WHILE */
    uint32_t last_print = HAL_GetTick();

    while (1)
    {
        /* ── Print ADC + raw current 10 times per second ── */
        if (HAL_GetTick() - last_print >= 100)
        {
            last_print = HAL_GetTick();
            uint32_t     adc         = read_adc();
            signed short raw_current = readINA219(INA219_REG_CURRENT);
            printf("ADC: %4lu  Current (raw 1/3 mA): %6d\r\n",
                   (unsigned long)adc, (int)raw_current);
        }

        /* ── Non-blocking character receive ── */
        uint8_t ch = 0;
        if (HAL_UART_Receive(&huart2, &ch, 1, 0) == HAL_OK)
        {
            /* ── 'a': run PI current control ── */
            if (ch == 'a')
            {
                printf("Starting current control run...\r\n");
                log_count = 0;
                state     = 1;

                /* Spin-wait; ISR sets state = 0 when done */
                while (state != 0) {}

                /* Stream CSV log back over serial */
                printf("IDX,DESIRED_mA_x10,ACTUAL_mA_x10,ADC\r\n");
                for (uint32_t i = 0; i < log_count; i++)
                {
                    int d = (int)(log_desired[i] * 10.0f);
                    int a = (int)(log_actual [i] * 10.0f);
                    printf("%lu,%d,%d,%u\r\n",
                           (unsigned long)i, d, a,
                           (unsigned int)log_adc[i]);
                }
                printf("Done.\r\n");
            }

            /* ── 't': quick motor test ── */
            else if (ch == 't')
            {
                printf("Forward 0.5 s...\r\n");
                motor_drive(PWM_PERIOD, PWM_HALF);
                HAL_Delay(500);
                motor_off();
                HAL_Delay(100);

                printf("Reverse 0.5 s...\r\n");
                motor_drive(PWM_HALF, PWM_PERIOD);
                HAL_Delay(500);
                motor_off();

                printf("Motor test done.\r\n");
            }
        }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    }
    /* USER CODE END 3 */
}

