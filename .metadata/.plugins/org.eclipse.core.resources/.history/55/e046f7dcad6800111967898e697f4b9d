/* ── main ────────────────────────────────────────────────────────────────── */
int main(void)
{
    /* USER CODE BEGIN 1 */
    /* USER CODE END 1 */

    HAL_Init();
    SystemClock_Config();

    /* Initialize peripherals */
    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_ADC1_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_I2C2_Init();

    /* USER CODE BEGIN 2 */

    // Initialize INA219
    init_ina219();

    // Start PWM outputs (both high = motor off initially)
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_OFF);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, PWM_OFF);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);

    // Start 1 kHz interrupt timer
    HAL_TIM_Base_Start_IT(&htim2);

    printf("Ready. Send 'a' to run current control.\r\n");
    printf("Send 't' to run motor test (50%% for ~0.5 s each direction).\r\n");

    /* USER CODE END 2 */

    /* ── Infinite loop ───────────────────────────────────────────────────── */
    /* USER CODE BEGIN WHILE */
    uint32_t last_print = HAL_GetTick();

    while (1)
    {
        /* ── Print ADC + current 10 times/second ── */
        if (HAL_GetTick() - last_print >= 100)
        {
            last_print = HAL_GetTick();
            uint32_t adc = read_adc();
            signed short raw_current = readINA219(INA219_REG_CURRENT);
            printf("ADC: %4lu  Current (raw): %6d\r\n",
                   (unsigned long)adc, (int)raw_current);
        }

        /* ── Check for user input ── */
        uint8_t ch = 0;
        if (HAL_UART_Receive(&huart2, &ch, 1, 0) == HAL_OK)
        {
            /* 'a' — run PI current control loop */
            if (ch == 'a')
            {
                printf("Starting current control run...\r\n");
                log_count = 0;
                state = 1;

                // Wait for interrupt to finish the run
                while (state != 0) { /* spin */ }

                // Print log: index, desired (mA), actual (mA), adc
                printf("IDX,DESIRED_mA,ACTUAL_mA,ADC\r\n");
                for (uint32_t i = 0; i < log_count; i++)
                {
                    // printf can't print floats on some STM32 configs,
                    // so we print as integers (×10 for one decimal place)
                    int desired_x10 = (int)(log_desired[i] * 10.0f);
                    int actual_x10  = (int)(log_actual [i] * 10.0f);
                    printf("%lu,%d,%d,%u\r\n",
                           (unsigned long)i,
                           desired_x10,
                           actual_x10,
                           (unsigned int)log_adc[i]);
                }
                printf("Done.\r\n");
            }

            /* 't' — quick motor test at 50% each direction */
            else if (ch == 't')
            {
                printf("Motor test: forward 0.5s...\r\n");
                motor_drive(PWM_PERIOD, PWM_HALF);   // forward ~50%
                HAL_Delay(500);
                motor_off();
                HAL_Delay(100);

                printf("Motor test: reverse 0.5s...\r\n");
                motor_drive(PWM_HALF, PWM_PERIOD);   // reverse ~50%
                HAL_Delay(500);
                motor_off();

                printf("Motor test done.\r\n");
            }
        }

        /* USER CODE END WHILE */
        /* USER CODE BEGIN 3 */
    }
    /* USER CODE END 3 */
}
