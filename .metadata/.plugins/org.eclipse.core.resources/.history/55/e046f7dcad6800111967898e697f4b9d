/* ── INA219 ──────────────────────────────────────────────────────────────── */
#define INA219_ADDR          0x40          // A0=A1=GND
#define INA219_REG_CONFIG    0x00
#define INA219_REG_SHUNT     0x01
#define INA219_REG_BUS       0x02
#define INA219_REG_POWER     0x03
#define INA219_REG_CURRENT   0x04
#define INA219_REG_CALIBRATION 0x05

/* ── ADC safety limits ───────────────────────────────────────────────────── */
#define ADC_MIN   250
#define ADC_MAX   (4095 - 250)

/* ── PWM ─────────────────────────────────────────────────────────────────── */
#define PWM_PERIOD   2400                  // Counter Period set in CubeMX
#define PWM_OFF      PWM_PERIOD            // both high = motor off
#define PWM_HALF     (PWM_PERIOD / 2)      // 50 % duty

/* ── PI controller ───────────────────────────────────────────────────────── */
#define KP              0.5f
#define KI              0.01f
#define DESIRED_CURRENT 300.0f             // mA  (absolute value)
#define LOG_SIZE        400                // samples per run

/* ── Volatile state shared between main and interrupt ────────────────────── */
volatile uint8_t  state        = 0;       // 0 = idle, 1 = run control loop

/* ── Data log (filled in interrupt, printed in main) ────────────────────── */
static float     log_desired[LOG_SIZE];
static float     log_actual [LOG_SIZE];
static uint16_t  log_adc    [LOG_SIZE];
static uint32_t  log_count  = 0;

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_ADC1_Init(void);
static void MX_TIM1_Init(void);
static void MX_TIM2_Init(void);
static void MX_I2C2_Init(void);

/* USER CODE BEGIN PFP */
uint32_t    read_adc(void);
void        init_ina219(void);
float       read_ina219(void);
void        writeINA219(int reg, int value);
signed short readINA219(unsigned char reg);
void        motor_off(void);
void        motor_drive(int pwm_ch1, int pwm_ch2);
/* USER CODE END PFP */

/* External handles generated by CubeMX ------------------------------------*/
extern ADC_HandleTypeDef  hadc1;
extern TIM_HandleTypeDef  htim1;
extern TIM_HandleTypeDef  htim2;
extern I2C_HandleTypeDef  hi2c2;
extern UART_HandleTypeDef huart2;

/* ── printf redirect to USART2 ─────────────────────────────────────────── */
/* USER CODE BEGIN 0 */
int __io_putchar(int ch)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
    return ch;
}

/* ── ADC ─────────────────────────────────────────────────────────────────── */
uint32_t read_adc(void)
{
    uint32_t raw = 0;
    HAL_ADC_Start(&hadc1);
    if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
        raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    return raw;
}

/* ── INA219 ──────────────────────────────────────────────────────────────── */
void writeINA219(int reg, int value)
{
    uint8_t buf[3];
    buf[0] = reg;
    buf[1] = (value >> 8) & 0xFF;
    buf[2] =  value       & 0xFF;
    HAL_I2C_Master_Transmit(&hi2c2, INA219_ADDR << 1, buf, 3, 10);
}

signed short readINA219(unsigned char reg)
{
    HAL_I2C_Master_Transmit(&hi2c2, INA219_ADDR << 1, &reg, 1, 10);
    uint8_t buffer[2];
    HAL_I2C_Master_Receive (&hi2c2, INA219_ADDR << 1, buffer, 2, 10);
    return (signed short)((buffer[0] << 8) | buffer[1]);
}

void init_ina219(void)
{
    // 10-bit, ±160 mV, 148 µs per sample
    unsigned short ina219_calValue = 1024;
    unsigned short ina219_config   = 0b0011000010001111;
    writeINA219(INA219_REG_CALIBRATION, ina219_calValue);
    writeINA219(INA219_REG_CONFIG,      ina219_config);
}

float read_ina219(void)
{
    signed short value = readINA219(INA219_REG_CURRENT);
    return value / 3.0f;   // convert raw units → mA
}

/* ── Motor helpers ───────────────────────────────────────────────────────── */
void motor_off(void)
{
    // Both inputs high = coast/off on DRV8833
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_OFF);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, PWM_OFF);
}

/**
 * Drive motor.
 * To spin forward:  pwm_ch1 = PWM_PERIOD (100%), pwm_ch2 = duty (0–PWM_PERIOD)
 * To spin reverse:  pwm_ch1 = duty,               pwm_ch2 = PWM_PERIOD
 * NEVER set both to 0 at the same time.
 */
void motor_drive(int pwm_ch1, int pwm_ch2)
{
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_ch1);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, pwm_ch2);
}

/* USER CODE END 0 */

/* ── 1 kHz TIM2 interrupt callback ──────────────────────────────────────── */
/* USER CODE BEGIN 4 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim != &htim2) return;

    /* ── Safety: read ADC; kill motor if out of range ── */
    uint32_t adc = read_adc();
    if (adc < ADC_MIN || adc > ADC_MAX)
    {
        motor_off();
        // If we were running a control loop, abort it cleanly
        if (state == 1) state = 0;
        return;
    }

    /* ── Control loop (state == 1) ── */
    if (state == 1)
    {
        static volatile uint32_t counter  = 0;
        static float             integral = 0.0f;

        // Desired current flips sign every 100 cycles
        float desired = (counter < 200) ? DESIRED_CURRENT : -DESIRED_CURRENT;

        // Read current sensor
        float actual = read_ina219();

        // PI controller
        float error   = desired - actual;
        integral     += error;

        // Anti-windup: clamp integral
        if (integral >  5000.0f) integral =  5000.0f;
        if (integral < -5000.0f) integral = -5000.0f;

        float output = KP * error + KI * integral;

        // Map controller output → PWM
        // Positive output → forward, negative → reverse
        int duty = (int)(output);
        if (duty >  PWM_PERIOD) duty =  PWM_PERIOD;
        if (duty < -PWM_PERIOD) duty = -PWM_PERIOD;

        if (duty >= 0)
            motor_drive(PWM_PERIOD, PWM_PERIOD - duty);  // forward
        else
            motor_drive(PWM_PERIOD + duty, PWM_PERIOD);  // reverse

        // Log data
        if (log_count < LOG_SIZE)
        {
            log_desired[log_count] = desired;
            log_actual [log_count] = actual;
            log_adc    [log_count] = (uint16_t)adc;
            log_count++;
        }

        counter++;

        // End of run
        if (counter >= LOG_SIZE)
        {
            motor_off();
            counter  = 0;
            integral = 0.0f;
            state    = 0;   // signal main loop that we're done
        }
    }
}
